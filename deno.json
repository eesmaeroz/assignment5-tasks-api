{
  "tasks": {
    "dev": "deno run -A --unstable-kv --unstable-cron --watch src/main.ts",
    "start": "deno run -A --unstable-kv --unstable-cron src/main.ts",
    "start:test": "deno run -A --unstable-kv --unstable-cron --env-file=.env.test src/main.ts",
    "start:prod": "deno run -A --unstable-kv --unstable-cron --env-file=.env.production src/main.ts",
    "test": "deno test -A --unstable-kv --unstable-cron",
    "check": "deno check --unstable-kv --unstable-cron src/*.ts tests/*.ts scripts/*.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "ui:install": "cd ui && deno install",
    "ui:dev": "cd ui && deno task dev",
    "seed": "deno run -A scripts/seed.ts",
    "n1": "deno run -A scripts/n1.ts",
    "explain": "deno run -A scripts/explain.ts"
  },
  "imports": {
    "hono": "npm:hono@^4",
    "zod": "npm:zod@^4",
    "bcryptjs": "npm:bcryptjs@^3",
    "drizzle-orm": "npm:drizzle-orm@^0.44",
    "drizzle-orm/libsql": "npm:drizzle-orm@^0.44/libsql",
    "drizzle-orm/sqlite-core": "npm:drizzle-orm@^0.44/sqlite-core",
    "@libsql/client": "npm:@libsql/client@^0.15",
    "@std/assert": "jsr:@std/assert@^1",
    "jose": "npm:jose@^6"
  },
  "fmt": {
    "lineWidth": 90
  }
}
